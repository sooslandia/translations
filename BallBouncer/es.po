msgctxt "UpdateAvailableQuestionText"
msgid "A new version of the game is available: {0}. Do you want to update now?"
msgstr ""
"Hay una nueva versión del juego disponible: {0}. ¿Quieres actualizar ahora?"

msgctxt "UpdateCheckingError"
msgid "An error occurred while checking for updates."
msgstr "Se produjo un error al buscar actualizaciones."

msgctxt "UpdateProcessScreenCanceled"
msgid "Cancelling..."
msgstr "Cancelado..."

#, python-brace-format
msgctxt "UpdateProcessScreenDownloading"
msgid "Downloading {0}%: {1} / {2}."
msgstr "Descargando {0}%: {1} / {2}."

msgctxt "UpdateProcessScreenFinished"
msgid "Installing..."
msgstr "Instalando..."

msgctxt "UpdateProcessScreenFinishedWithError"
msgid ""
"An error occurred during the update. Please try again later or download a "
"new version from the site yourself. Press enter to continue."
msgstr ""
"Se produjo un error durante la actualización. Inténtalo de nuevo más tarde o "
"descarga tú mismo la nueva versión desde el sitio web. Presiona enter para "
"continuar."

msgctxt "UpdateProcessScreenStarting"
msgid "Preparing to download. Please wait."
msgstr "Preparando la descarga. Espera, por favor."

msgctxt "UpdateProcessScreenTitle"
msgid "The update is downloading. Please wait."
msgstr "Se está descargando la actualización. Espera, por favor."

msgctxt "UpdateProcessScreenTitleWithHint"
msgid ""
"The update is downloading. Please wait. To check the progress, press any "
"arrow key."
msgstr ""
"Se está descargando la actualización. Espera, por favor. Para comprobar el "
"progreso, presiona cualquier flecha."

msgctxt "WelcomeMenu1"
msgid ""
"Welcome to ball bouncer. Use the up and down arrow keys to navigate through "
"this menu."
msgstr ""
"Te damos la bienvenida a ball bouncer. Presiona las flechas hacia arriba y "
"hacia abajo para navegar por este menú."

msgctxt "WelcomeMenu2"
msgid "We, the developers of this game, are glad that you downloaded it!"
msgstr ""
"¡Nosotros, los desarrolladores de este juego, nos alegramos de que lo hayas "
"descargado!"

#, python-brace-format
msgctxt "WelcomeMenu3"
msgid ""
"To get started, we strongly recommend checking out the game's documentation, "
"which is located in {0}."
msgstr ""
"Para comenzar, te recomendamos encarecidamente que leas la documentación de "
"ayuda de este juego, que se encuentra en {0}."

msgctxt "WelcomeMenu4"
msgid "Or press enter here to open the documentation."
msgstr "O presiona enter aquí para abrir la documentación."

msgctxt "WelcomeMenu5"
msgid "Have a great time, player."
msgstr "Que lo pases genial, jugador."

msgctxt "WelcomeMenu6"
msgid "Press enter to continue."
msgstr "Presiona enter para continuar."

msgctxt "YesOrNoScreenNo"
msgid "No"
msgstr "NO."

msgctxt "YesOrNoScreenYes"
msgid "Yes"
msgstr "Sí."

