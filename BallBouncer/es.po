msgctxt "SoundPanningSettingsFormBallViewPanStep"
msgid "Pan step in ball watch mode"
msgstr "Paso de panorámica en el modo de seguimiento de la pelota"

msgctxt "SoundPanningSettingsFormBallViewVolumeStep"
